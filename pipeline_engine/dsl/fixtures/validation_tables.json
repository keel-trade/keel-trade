{
  "use_ref_pattern": "^str_[0-9a-z]{26}@[1-9][0-9]*$",
  "use_max_depth": 8,
  "output_roles": [
    "signal",
    "filter",
    "universe",
    "event",
    "regime"
  ],
  "output_shape_bases": {
    "panel": "SignalSeries",
    "single": "GlobalSeries"
  },
  "output_cross_sectional_components": [
    "CrossSectionalZScore",
    "QuantileRankTransform",
    "RankTransform",
    "TopNAssetSelector"
  ],
  "outputs_max": 3,
  "output_name_pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
  "output_name_reserved": [
    "AUX",
    "COM1",
    "COM2",
    "COM3",
    "COM4",
    "COM5",
    "COM6",
    "COM7",
    "COM8",

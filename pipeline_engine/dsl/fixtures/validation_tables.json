    "LPT7",
    "LPT8",
    "LPT9",
    "NUL",
    "PRN",
    "constructor",
    "hasOwnProperty",
    "prototype",
    "toString",
    "valueOf"
  ],
  "output_units": [
    "percent",
    "fraction",
    "rate_per_hour",
    "rate_per_year",
    "price",
    "notional",
    "count",
    "score",
    "rank",
    "flag",
    "unknown"
  ],
  "unit_words": {
    "percent": "{output} is percent \u00d7 100: 5.0 = 5%",
    "fraction": "{output} is a ratio: 0.05 = 5%",
    "rate_per_hour": "{output} is a decimal per hour: 0.05 = 5% per hour",
    "rate_per_year": "{output} is a decimal per year: 0.05 = 5% per year",
    "price": "{output} is price in quote units",
    "notional": "{output} is notional in quote units",
    "count": "{output} is a count",
    "score": "{output} is a dimensionless score",
    "rank": "{output} is a rank or percentile in [0, 1]",
    "flag": "{output} is a flag: 0 or 1, or \u22121, 0 or 1",
    "unknown": "{output} is unknown units; no unit is declared or derivable"
  },
